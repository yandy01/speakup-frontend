# Google Gemini — clé privée, uniquement côté serveur.
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-3.8-flash
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
GEMINI_SPEECH_FALLBACK_MODEL=gemini-3.8-flash-lite-tts

