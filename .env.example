# Supabase — la clé publishable peut être utilisée côté navigateur.
SUPABASE_URL=https://ohicenlft.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://oocenlft.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Agnes AI — clé privée, uniquement côté serveur.
AGNES_AI_API_KEY=
