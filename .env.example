# Supabase — use the project URL and the publishable/anon key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Alternative name accepted by this project if your dashboard exposes an anon key:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# URL of YOUR secured backend. Never put Agnes AI or Gemini secret keys here.
# Example: https://api.your-domain.com
VITE_API_BASE_URL=/api

# Optional Google/Apple OAuth providers must also be configured in Supabase Auth.

# Backend Vercel — configure these in Vercel Project Settings > Environment Variables.
# NEVER prefix provider secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Alternative for legacy Supabase projects:
# SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
AGNES_AI_API_KEY=YOUR_AGNES_SECRET_KEY
AGNES_AI_MODEL=agnes-2.5-flash
# Legacy aliases accepted too: AGNES_API_KEY, AGNES_MODEL, AGNES_API_URL
GEMINI_API_KEY=YOUR_GEMINI_SECRET_KEY
GEMINI_MODEL=gemini-2.5-flash
# Optional separate model identifier supporting audio input
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_AUDIO_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
GEMINI_SPEECH_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
# Optional, comma-separated origins for a separately hosted frontend.
# Same-origin Vercel deployments do not need this.
ALLOWED_ORIGINS=
